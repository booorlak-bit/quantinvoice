# Supabase shared pooler (transaction mode, port 6543) as the dedicated app role.
# Username format: quantinvoice_app.<project-ref>
DATABASE_URL=postgresql://quantinvoice_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Random string, 32+ characters. Signs sessions and sign-in codes; changing it signs everyone out.
SESSION_SECRET=

# Resend: sign-in codes and invoice emails. The sender must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="fliq.email <hello@mail.example.com>"

# Optional: who may create an account (emails or @domains, comma-separated). Empty means anyone.
SIGNUP_EMAILS=

# Optional: the site's address for links in emails and PDFs.
APP_URL=

# Local only: print sign-in codes to the server log when Resend isn't configured.
# LOGIN_CODES_TO_CONSOLE=1
