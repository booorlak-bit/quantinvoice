# Supabase shared pooler (transaction mode, port 6543) as the dedicated app role.
# Username format: quantinvoice_app.<project-ref>
DATABASE_URL=postgresql://quantinvoice_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Password for /login. Changing it signs every session out.
ADMIN_PASSWORD=

# Random string, 32+ characters, used to sign the admin session cookie.
SESSION_SECRET=
